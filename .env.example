# RugMunchBot — Environment Variables
# Copy to .env (never commit .env — use a secrets manager for real deployments)

# ── Bot (required to run) ─────────────────────────────────────────────
# Token from @BotFather. This is the ONLY required variable.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs with admin/owner access.
# Leave empty to disable owner-only commands.
# [DEPRECATED] renamed to TELEGRAM_ALLOWED_USERS (rugmunchbot/config.py) —
# comma-separated numeric owner/operator ids; unset/empty = no owner commands.
BOT_OWNER_IDS=

# [DEPRECATED] channel chat-ids now come from the shared channels registry
# (app/core/channels_registry.py: gopass -> env -> documented fallback).
BOT_CHANNELS=

# ── Optional backend (operator's own scanner/data API) ────────────────
RMI_BACKEND_URL=http://localhost:8000
# [DEPRECATED] renamed to RMI_AUTH_TOKEN (shared backend X-API-Key).
RMI_API_KEY=
# Deep 9-module forensic scan endpoint (operator's own deployment).
# Renamed from SENTINEL_URL on 2026-08-14 — the feature is now "advanced".
# [DEPRECATED] renamed back to SENTINEL_URL (env override for the deep
# forensic scan endpoint).
ADVANCED_SCAN_URL=

# ── Free-tier quotas (weekly) ─────────────────────────────────────────
BOT_FREE_SCANS_PER_WEEK=25
BOT_FREE_AI_MSGS_PER_WEEK=15

# ── DEX referral links (your own ref codes) ───────────────────────────
# JSON: {"gmgn": {"url": "https://gmgn.ai/sol/token/{token}?ref=YOURCODE"}, ...}
BOT_DEX_REF_LINKS=
# Or per-platform ref codes (empty = no ?ref= param):
RMI_REF_GMGN=
RMI_REF_DEXTOOLS=

# ── External APIs ─────────────────────────────────────────────────────
BIRDEYE_API_KEY=
# Backup/fallback OpenRouter key for chat fallback chains (app.llm_config).
OPENROUTER_BACKUP_API_KEY=
SEARXNG_URL=http://127.0.0.1:8889

# ── Pry (self-hosted web intelligence API) ────────────────────────────
# Pry is OUR app (host loopback :8005). Its /v1/scrape endpoints are gated
# behind x402 payment; the internal API key bypasses it (sent as
# Authorization: Bearer). Set PRY_X402_OFFLINE=true to also send the
# X-X402-Offline header (server-side offline bypass; requires DEBUG on Pry).
PRYSCRAPER_URL=http://127.0.0.1:8005
PRY_API_KEY=
PRY_X402_OFFLINE=false

# ── Local LLM (chat fallback; OpenAI-compatible endpoint) ─────────────
# [DEPRECATED] BOT_LLM_* names are not read by the live bot. Use LLAMA_HOST
# (qwen-chat :8085 / qwen-analysis :8086) — see the live-config section below.
BOT_LLM_API_BASE=http://127.0.0.1:8085/v1/chat/completions
BOT_LLM_MODEL=
BOT_LLM_API_KEY=

# ── Storage / runtime ─────────────────────────────────────────────────
BOT_DB_PATH=./data/bot_users.db
LOG_LEVEL=INFO
RMI_BOT_BETA_MODE=false

# ── Redis (optional flood-control cache; SQLite fallback if unset) ────
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# ── LIVE bot config (canonical — rmi-backend) ─────────────────────────
# The running bot lives at rmi-backend/app/domains/telegram/rugmunchbot/.
# The full env surface is documented in rmi-backend/.env.example; the vars
# below are the ones this standalone scaffold docs most often get wrong.

# Owner/operator ids — FAIL-CLOSED (no built-in id). Empty = no owner commands.
TELEGRAM_ALLOWED_USERS=

# Host of the local llama.cpp servers (chat fallback). FAIL-CLOSED: when
# unset/empty the local LLM fallback is disabled (warning logged). Use the
# docker bridge gateway (e.g. 172.17.0.1) when the bot runs in a container
# and llama.cpp runs on the host.
LLAMA_HOST=127.0.0.1

# Admin bot (app/domains/telegram/adminbot).
ADMIN_CHAT_ID=
ADMIN_BOT_TOKEN=

# Alert routing map (alert_hooks.py). Format "<chat_id>:<label>,...":
ALERT_TARGETS=

# Ghost Admin API key for the personal-channel cross-post
# (format <id>:<secret>; also set GHOST_ADMIN_API_URL).
GHOST_ADMIN_API_KEY=

# Redis URL (preferred) for flood-control/state; falls back to
# REDIS_HOST / REDIS_PORT / REDIS_PASSWORD (see the legacy Redis section below).
REDIS_URL=

# ── Channel entrance guard / anti-abuse (moderation/guard_settings.py) ──
# All optional; unset = the safe defaults below. Per-chat overrides live in the
# chat's "guard" object in configs/moderation.json and win over these.
# RUGMUNCH_MOD_BOT_QUARANTINE=true        # hold every joining bot for a human
# RUGMUNCH_MOD_NEW_ACCOUNT_ID_MIN=7000000000  # account-age PROXY (id watermark)
# RUGMUNCH_MOD_QUARANTINE_SCORE=50        # risk score that triggers a hold
# RUGMUNCH_MOD_SCORE_NEW_ACCOUNT=35
# RUGMUNCH_MOD_SCORE_NO_USERNAME=15
# RUGMUNCH_MOD_SCORE_BOT_PATTERN=30
# RUGMUNCH_MOD_SCORE_SCAM_NAME=30
# RUGMUNCH_MOD_RAID_JOINS=8               # joins per window that mean "raid"
# RUGMUNCH_MOD_RAID_WINDOW_S=30
# RUGMUNCH_MOD_RAID_HOLD_S=600            # auto-release TTL (/modraid off to lift)
# RUGMUNCH_MOD_FLOOD_MSGS=25              # messages per window that mean "flood"
# RUGMUNCH_MOD_FLOOD_WINDOW_S=10
# RUGMUNCH_MOD_RAID_MESSAGE_ACTION=delete # warn|delete|mute|alert
# RUGMUNCH_MOD_QUARANTINE_CHANNEL_ID=0    # private admin channel for holds
# RUGMUNCH_MOD_QUARANTINE_MUTE_MINUTES=1440
# RUGMUNCH_MOD_TRUSTED_USER_IDS=          # csv; skips entrance quarantine only

# Known-scam address denylist (anti_abuse.py) — comma-separated addresses.
RUGMUNCH_SCAM_DENYLIST=

# ── X/Twitter intel — MOVED to rugbrain (RAG) ─────────────────────────
# X ingestion (fetch, normalize, embed, ingest) is owned by rugbrain.
# The bot no longer implements X fetching, embeddings, ingest pipelines,
# or Qdrant internals. It may CONSUME X-derived intel through the RAG
# HTTP API (tools/rag_lookup.py). No ApiPass/GetXAPI keys are needed.
# See docs/X-INTEL-MOVED.md.

# Security keyword search (2026-09-02): ONE GetXAPI advanced_search per tick
# against a rotating security query (exploit/hack/drained/rug pull/audit/scam/
# flash loan/MEV/bridge/DEFI) → RAG news_v2. 48 calls/day = $0.048/day.
RMI_SECURITY_SEARCH_ENABLED=true
RMI_SECURITY_SEARCH_INTERVAL_MINUTES=30
RMI_SECURITY_SEARCH_MIN_TWEET_CHARS=8

# ── KOL Scoreboard (2026-08-29; renamed from KOL Hall of Shame) ───────
# The main product: per-KOL report cards (calls, win/loss, deleted tweets,
# shills, scam-token calls, traced wallet, screen-name changes, score/grade)
# over a ~565-account registry seeded from real fleet data (504 influential
# CT accounts + 31 evidence-backed scammers + 945-wallet KB + rug history).
# "Hall of Shame" is the repeat-scammer subset. RMI_KOL_CALL_STORE_PATH can
# point at rmi-backend's app/databus/scammer_calls.json so the site's
# GET /api/v1/kol/scammer-calls renders the scoreboard.
RMI_KOL_SCOREBOARD_ENABLED=true
RMI_KOL_SCOREBOARD_INTERVAL_MIN=90
RMI_KOL_SCOREBOARD_MAX_ALERTS=2
RMI_KOL_TRACKED_HANDLES=
RMI_KOL_CALL_STORE_PATH=
# KOL handles the alpha lane pulls real X trades from (ApiPass first rail).
RMI_KOL_ALPHA_HANDLES=lookonchain,spotonchain,ArkhamIntel,cryptowhaletrades,ThinkingUSD,0xfoobar

# Swept TG news: title rewrite (default off) and t.me dereference (default on).
RMI_NEWS_TITLE_REWRITE_ENABLED=false
RMI_NEWS_TME_RESOLVE_ENABLED=true

# Personal-channel → Ghost blog cross-post master switch (default off).
RMI_GHOST_CROSSPOST_ENABLED=false

# Daily market brief (channels/daily_market_summary.py) — 7:00 AM ET editorial
# brief to @cryptorugmuncher + rugmunch.io feed. All optional (defaults shown).
RMI_DAILY_MARKET_BRIEF_ENABLED=true
RMI_DAILY_MARKET_BRIEF_TIME=07:00
RMI_DAILY_MARKET_BRIEF_TZ=America/New_York
RMI_DAILY_MARKET_BRIEF_MAX_CHARS=3500
RMI_DAILY_MARKET_BRIEF_FEED_ENABLED=true
RMI_DAILY_MARKET_BRIEF_WEB_SIGNALS_ENABLED=true

# Rerank-importance floors (channels/router.py).
RMI_ROUTE_NEWS_MIN_IMPORTANCE=0.4
RMI_ROUTE_MAIN_MIN_IMPORTANCE=0.7

# TG-news sweep source lists (channels/telegram_news/_sources/_config.py).
# Comma-separated handles. The sweep reads these PLUS the account's own
# followed channels (auto-discovery); analyst and scam-call handles are
# force-tagged so routing sends them to the right channel.
RMI_TG_NEWS_ANALYST_CHANNELS=lookonchain,spotonchain,ArkhamIntel,OnChainWizard,nansen_ai,nansen_digest,glassnode,cryptowhaletrades,chainfeeds,intotheblock,SantimentFeed,duneanalytics,defillama,MessariCrypto,tokenterminal,DelphiDigital
# Scam-call / shill-intel channels -> scored digests post to @rmialerts
# (category "scam"; never the news channel).
RMI_TG_NEWS_SCAM_CHANNELS=thepumpalert,CallAnalyser,walloftrophies,FuzzLandAlert,BeosinAlert,ScamSniffer,rektnews,zachxbt,SlowMist

# Moderation community data (notes, filters, global bans, schedules).
# Off by default: entries live in process memory and reset on restart.
# Set to 1 to persist them in Redis (same REDIS_URL the bot already uses).
RUGMUNCH_MODERATION_REDIS=0
# Optional key namespace prefix (default rmi:mod:v1).
RUGMUNCH_MODERATION_NS=rmi:mod:v1

# ── Polymarket content/referral engine (src/rugmunchbot/polymarket) ───────
# Read-only market + public-flow intelligence. The engine never trades, signs,
# or transfers. Dry run is the DEFAULT and no publisher is wired by default.
POLYMARKET_DRY_RUN=true
# Our wallet — verified $0.00 value / zero positions (2026-10-24).
POLYMARKET_WALLET=0x1E3AC01d0fdb976179790BDD02823196A92705C9
# ONLY the referral URL Polymarket generated for this account. Earnings need
# $10,000 lifetime volume (10% direct / 5% indirect, 30 days or until Gold;
# omnibus + self-referral banned). Leave blank until a real link exists —
# the engine never constructs one.
POLYMARKET_REFERRAL_URL=
# Builder profile code from Polymarket Settings -> Builders (bytes32 hex).
# Attached to orders; fee cap 100 bps taker / 50 bps maker.
POLYMARKET_BUILDER_CODE=
# Selection floors and lane filter.
POLYMARKET_MIN_VOLUME_USD=250000
POLYMARKET_MIN_LIQUIDITY_USD=50000
POLYMARKET_MIN_ABS_CHANGE_1D=0.05
POLYMARKET_MIN_TRADE_NOTIONAL_USD=10000
POLYMARKET_MAX_MARKETS=3
POLYMARKET_CATEGORIES=crypto,macro,politics,tech
