# scripts/policy-budgets.env — suppression ratchets (docs/GOOD-CODE-POLICY.md §4)
# Counts may go DOWN, never up. Re-baselined 2026-09-18 (first measurement).
NOQA_BUDGET=279
TYPE_IGNORE_BUDGET=287
PRAGMA_NO_COVER_BUDGET=110

# Monkeypatch ratchet (policy §1): src must stay 0; tests may only go down.
MONKEYPATCH_TEST_BUDGET=1347

# ── God files: 500-line standard (operator direction 2026-09-18) ────────────
# First-party modules must be <= 500 lines. These 35 are GRANDFATHERED and
# may only SHRINK as we split them — remove an entry the moment its file is
# split. Any file NOT on this list that exceeds 500 lines FAILS the gate.
GOD_FILE_ALLOW="src/rugmunchbot/formatters/_scan_report_deepscan/_sentinel.py src/rugmunchbot/tools/scanner/_scans.py src/rugmunchbot/channels/daily_rug_update/_publish.py src/rugmunchbot/tools/x_ingest.py src/rugmunchbot/channels/scheduler/_register.py src/rugmunchbot/channels/content/pipeline.py src/rugmunchbot/channels/ct_shill_watch.py src/rugmunchbot/tools/rag_lookup.py src/rugmunchbot/handlers/admin/__init__.py src/rugmunchbot/tools/ta.py src/rugmunchbot/llm_config.py src/rugmunchbot/handlers/chat_ai/_llm/_router/_market.py src/rugmunchbot/tools/scanner/_solana_onchain.py src/rugmunchbot/tools/scanner/_local_v2.py src/rugmunchbot/handlers/chat_ai/_guards.py src/rugmunchbot/kol_registry_seed.py src/rugmunchbot/tools/getxapi_budget.py src/rugmunchbot/handlers/chat_ai/_llm/_clients.py src/rugmunchbot/support/content_lint.py src/rugmunchbot/channels/telegram_news/_scheduler.py src/rugmunchbot/tools/market_condition.py src/rugmunchbot/formatters/_scan_report_common/_layout.py src/rugmunchbot/handlers/market/_commands.py src/rugmunchbot/tools/social_monitor.py src/rugmunchbot/handlers/chat_ai/_routing/_core.py src/rugmunchbot/tools/scanner/_flatten.py src/rugmunchbot/commands/chart.py src/rugmunchbot/handlers/_market_helpers.py src/rugmunchbot/formatters/_scan_report_main.py src/rugmunchbot/channels/quality_schedule.py src/rugmunchbot/channels/kol_scoreboard/data.py src/rugmunchbot/handlers/_scan_handlers/_extras.py src/rugmunchbot/services/pricing.py src/rugmunchbot/channels/telegram_news/_digest.py"
