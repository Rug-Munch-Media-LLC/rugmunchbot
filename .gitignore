# Generic / orphaned-repo .gitignore — Rug Munch Media fleet standard
# See https://git.rugmunch.io/RugMunchMedia/standards for source of truth.

# ── Secrets (zero tolerance) ───────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.session
*.token
credentials.json
service-account.json
.secrets/

# ── Common artifacts ───────────────────────────────────────────
node_modules/
dist/
build/
*.log
.DS_Store
__pycache__/
*.pyc
.venv/
venv/
.cache/
tmp/
*.tmp
*.swp
*.swo
*~

# ── Runtime state (never commit) ───────────────────────────────
# Local SQLite state created at runtime — never source-controlled.
**/data/*.db
**/data/*.db-*
# KOL Hall-of-Shame JSONL site bridge (runtime export; may hold call data).
**/data/*.jsonl

# ── IDE ────────────────────────────────────────────────────────
.vscode/
.idea/
# Heredoc accident leftovers (created by bash <<EOF bypass)
u00261
u00262
u003c
u003e


# Turbo
.turbo
src/rugmunchbot/_vendor/data/

# Coverage artifacts (regenerated every run — never track)
.coverage
.coverage.*
coverage.xml
coverage.lcov
htmlcov/

# runtime cursors
src/rugmunchbot/data/kol/ct_cursor.json
.config/
.methodology-patterns

# Serena MCP tooling artifacts (local, not project code)
.serena/
