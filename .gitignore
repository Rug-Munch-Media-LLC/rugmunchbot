# Generic / orphaned-repo .gitignore — Rug Munch Media fleet standard
# See https://git.rugmunch.io/RugMunchMedia/standards for source of truth.

# ── Secrets (zero tolerance) ───────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.session
*.token
credentials.json
service-account.json
.secrets/

# ── Common artifacts ───────────────────────────────────────────
node_modules/
dist/
build/
*.log
.DS_Store
__pycache__/
*.pyc
.venv/
venv/
.cache/
tmp/
*.tmp
*.swp
*.swo
*~

# ── Runtime state (never commit) ───────────────────────────────
# Local SQLite state created at runtime — never source-controlled.
**/data/*.db
**/data/*.db-*

# ── IDE ────────────────────────────────────────────────────────
.vscode/
.idea/
# Heredoc accident leftovers (created by bash <<EOF bypass)
u00261
u00262
u003c
u003e


# Turbo
.turbo
