# =============================================================================
# Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NOTE: Never commit the actual .env file to version control.
# =============================================================================

# --- General ---
# APP_NAME=myapp
# APP_ENV=production
# APP_DEBUG=false

# --- Database ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mydb
# DB_USER=user
# DB_PASSWORD=changeme

# --- Secrets (set via gopass) ---
# API_KEY=
# JWT_SECRET=
# TOKEN=

# --- Optional ---
# LOG_LEVEL=info
# METRICS_ENABLED=true
